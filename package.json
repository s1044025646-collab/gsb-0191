{
  "name": "delaunay-voronoi-backend",
  "version": "1.0.0",
  "description": "平面点集 Delaunay 三角剖分与裁剪 Voronoi 单元后端（API + CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
